# -----------------------------------------------------------------------------
# EarningsLens — root environment template (copy to .env and fill in)
# Used by tooling that expects a single repo-level env file. Backend and
# frontend may also use their own .env.example files for process-specific vars.
# -----------------------------------------------------------------------------

# Anthropic (Claude) — server-side analysis / tool use
ANTHROPIC_API_KEY=

# Deepgram — real-time transcription (server-side proxy or future WebSocket).
# Loaded by Settings as deepgram_api_key; browser client may use VITE_DEEPGRAM_API_KEY in frontend/.env.local.
DEEPGRAM_API_KEY=

# Optional: SEC EDGAR User-Agent (SEC requires identification in requests)
SEC_EDGAR_USER_AGENT=EarningsLens/0.1 (contact@example.com)

# Finnhub — stock quotes (backend GET /market/quote/{ticker}); https://finnhub.io/register
FINNHUB_API_KEY=

# Financial Modeling Prep (optional — for future fundamentals / calendar endpoints)
# https://site.financialmodelingprep.com/developer/docs — prefer server-side only; do not use VITE_ for secrets.
FMP_API_KEY=

# Deployed frontend origin(s) allowed by backend CORS, comma-separated (e.g. https://your-app.vercel.app)
CORS_ORIGINS=

# Backend URL when frontend runs separately (Vite dev server). Use /api with Vite proxy in dev.
VITE_API_BASE_URL=http://127.0.0.1:8000
