# -----------------------------------------------------------------------------
# EarningsLens — root environment template (copy to .env and fill in)
# Used by tooling that expects a single repo-level env file. Backend and
# frontend may also use their own .env.example files for process-specific vars.
# -----------------------------------------------------------------------------

# Anthropic (Claude) — server-side analysis / tool use
ANTHROPIC_API_KEY=

# Deepgram — real-time transcription (WebSocket); may be referenced by backend
# for proxying or by frontend directly depending on deployment choice.
DEEPGRAM_API_KEY=

# Optional: SEC EDGAR User-Agent (SEC requires identification in requests)
SEC_EDGAR_USER_AGENT=EarningsLens/0.1 (contact@example.com)

# Finnhub — stock quotes (backend GET /market/quote/{ticker}); https://finnhub.io/register
FINNHUB_API_KEY=

# Backend URL when frontend runs separately (Vite dev server)
VITE_API_BASE_URL=http://127.0.0.1:8000
