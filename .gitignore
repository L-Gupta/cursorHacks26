# -----------------------------------------------------------------------------
# EarningsLens — root ignore rules
# Excludes secrets, local databases, Python/Node artifacts, and OS junk so
# clones stay clean and CI caches behave predictably across dev machines.
# -----------------------------------------------------------------------------

# Environment and secrets (never commit real API keys)
.env
.env.local
.env.*.local
*.pem

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ChromaDB local persistence (per-machine vector store)
chroma_data/
**/chroma_data/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Local databases / caches (if added later)
*.sqlite
*.sqlite3
*.db

# Large demo media (optional — remove the line below if you intentionally vendor small samples)
frontend/public/demo/*.mp3

# Root-level node_modules (e.g. tooling at repo root)
node_modules/

# Legacy teammate path (removed from repo — do not re-commit vendor trees here)
earningslens/
