# -----------------------------------------------------------------------------
# EarningsLens — frontend (Vite) environment
# Copy to frontend/.env.local. Only variables prefixed with VITE_ are exposed
# to browser code; never put server secrets here if using client-side Deepgram.
# -----------------------------------------------------------------------------

# Public API base for fetch() to FastAPI (or use Vite proxy /api in dev)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Deepgram client key when using browser WebSocket (rotate for production)
VITE_DEEPGRAM_API_KEY=
